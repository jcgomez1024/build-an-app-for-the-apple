    {
      "id": "ful-no-delivery",
      "match": "\\b(?:no|not)\\s+(?:es\\s+|is\\s+)?(?:para\\s+|for\\s+)?(?:delivery|entrega(?:\\s+a\\s+domicilio)?|a\\s+domicilio)\\b",
      "to": "no __DELIVERY__",
