      "match": "\\bguarache(s?)\\b",
      "to": "huarache$1",
      "scope": [
        "phone",
        "app"
      ],
      "example": "quiero un guarache de prensado",
      "source": "phone call-scoring FOOD list + transcripts",
      "approved": "Carlos 2026-10-19"
    },
    {
