{
  "name": "@cocina-elvis/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:guides": "tsx scripts/build-guides.ts",
    "check:guides": "tsx scripts/check-guides.ts",
    "build:pack-guides": "tsx scripts/pack-especial-guides.ts",
    "check:pack-guides": "tsx scripts/pack-especial-guides.ts --check",
    "sync:site-menu": "tsx scripts/site-menu-sync.ts",
    "check:site-menu": "tsx scripts/check-site-menu.ts",
    "replay": "tsx --test test/replay/*.test.ts",
    "auditor:run": "tsx scripts/auditor.ts run",
    "auditor:pending": "tsx scripts/auditor.ts pending",
    "auditor:ack": "tsx scripts/auditor.ts ack"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "nanoid": "^5.0.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
