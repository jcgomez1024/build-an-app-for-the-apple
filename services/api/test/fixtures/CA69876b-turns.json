    "end": 73.43,
    "language": "es"
  },
  {
    "speaker": "caller",
    "text": "Nada más crema, no.",
    "start": 82.133,
    "end": 83.194,
    "language": "es"
  },
  {
    "speaker": "caller",
    "text": "Am, y un sopesazo de bistec",
