    "end": 99.121,
    "language": "es"
  },
  {
    "speaker": "caller",
    "text": "Y un taco taquero de bistec.",
    "start": 101.682,
    "end": 104.383,
    "language": "es"
  },
  {
    "speaker": "caller",
    "text": "Ah, sería nombre de Francisco.",
    "start": 109.765,
    "end": 111.747,
    "language": "es"
  },
  {
    "speaker": "caller",
    "text": "Ah, y si me puede poner dos aguas de horchata, chicas.",
    "start": 116.269,
    "end": 120.211,
    "language": "es"
  },
  {
    "speaker": "caller",
    "text": "Sí.",
    "start": 125.254,
    "end": 125.334,
    "language": "es"
  },
  {
    "speaker": "caller",
    "text": "Está bien, gracias.",
