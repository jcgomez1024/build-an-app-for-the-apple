[{"speaker": "caller", "start": 4.601, "end": 6.721, "text": "Hola.", "language": "en"}, {"speaker": "staff", "start": 5.481, "end": 6.502, "text": "Ah, cocina Elvis.", "language": "es"}, {"speaker": "caller", "start": 7.762, "end": 9.302, "text": "¿Puedes una orden, por favor?", "language": "es"}, {"speaker": "staff", "start": 9.743, "end": 10.323, "text": "Ah, claro.", "language": "es"}, {"speaker": "caller", "start": 12.183, "end": 13.843, "text": "Va a ser un guarache de bistec.", "language": "es"}, {"speaker": "staff", "start": 15.024, "end": 17.465, "text": "Un guarache de bistec, muy bien. Este,", "language": "es"}, {"speaker": "staff", "start": 18.385, "end": 21.706, "text": "gusta le frijole, lechuga, crema y queso fresco.", "language": "es"}, {"speaker": "caller", "start": 22.785, "end": 24.385, "text": "Sí, estoy preparado, por favor.", "language": "es"}, {"speaker": "staff", "start": 24.226, "end": 25.527, "text": "Ajá, ¿algo más?", "language": "es"}, {"speaker": "caller", "start": 26.445, "end": 29.306, "text": "Otro guarache de bistec con chorizo preparado igual.", "language": "es"}, {"speaker": "staff", "start": 29.888, "end": 31.908, "text": "Muy bien, ¿algo más?", "language": "es"}, {"speaker": "caller", "start": 32.907, "end": 35.547, "text": "A dos tortas de tripas bien doradas.", "language": "es"}, {"speaker": "staff", "start": 36.249, "end": 36.83, "text": "Muy bien.", "language": "es"}, {"speaker": "caller", "start": 38.888, "end": 41.429, "text": "Esa es solas, la verdura aparte.", "language": "en"}, {"speaker": "staff", "start": 41.871, "end": 42.231, "text": "Muy bien.", "language": "es"}, {"speaker": "caller", "start": 44.229, "end": 51.331, "text": "A dos tacos, tres tacos chicos de bistec. Sí.", "language": "es"}, {"speaker": "staff", "start": 48.672, "end": 50.453, "text": "Tres tacos ch, taqueros, ¿verdad?", "language": "es"}, {"speaker": "staff", "start": 52.033, "end": 53.213, "text": "Muy bien, ¿algo más?", "language": "es"}, {"speaker": "caller", "start": 54.171, "end": 55.231, "text": "Una orden de arroz.", "language": "es"}, {"speaker": "staff", "start": 55.713, "end": 59.354, "text": "Y una orden de arroz, la orden de arroz la quiere chica o grande.", "language": "es"}, {"speaker": "caller", "start": 60.152, "end": 60.452, "text": "Chica.", "language": "en"}, {"speaker": "staff", "start": 61.034, "end": 62.174, "text": "Muy bien, ¿algo más?", "language": "es"}, {"speaker": "caller", "start": 62.993, "end": 63.633, "text": "Seria toda.", "language": "en"}, {"speaker": "staff", "start": 64.075, "end": 71.036, "text": "Entonces ten, tengo una orden de arroz, tres tacos taqueros de biste, dos tortas de tripa, la tripa dorada,", "language": "es"}, {"speaker": "staff", "start": 72.036, "end": 82.057, "text": "un guarache de biste con chorizo, frijole, lechuga, crema y queso fresco, y un guarache de biste, frijole, lechuga y crema y queso fresco, ¿correcto?", "language": "es"}, {"speaker": "caller", "start": 83.097, "end": 83.197, "text": "Si.", "language": "en"}, {"speaker": "staff", "start": 83.097, "end": 83.637, "text": "Nos vemos.", "language": "es"}, {"speaker": "staff", "start": 84.757, "end": 86.318, "text": "Ah, ¿a qué nombre sería la orden?", "language": "es"}, {"speaker": "caller", "start": 87.357, "end": 87.817, "text": "Braulio.", "language": "en"}, {"speaker": "staff", "start": 88.418, "end": 93.819, "text": "Braulio. Okey, Braulio, este, dame unos, mm, unos veinte minutos.", "language": "es"}, {"speaker": "caller", "start": 94.939, "end": 95.559, "text": "Okay, está bien.", "language": "es"}, {"speaker": "staff", "start": 95.859, "end": 96.399, "text": "Gracias.", "language": "es"}, {"speaker": "caller", "start": 97.859, "end": 97.959, "text": "va.", "language": "en"}]