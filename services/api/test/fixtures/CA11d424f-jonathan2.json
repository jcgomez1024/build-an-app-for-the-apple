{
  "callSid": "CA11d424f75224c8861912e45315aee381",
  "name": "Jonathan",
  "turns": [
    { "speaker": "staff", "start": 1, "end": 3, "text": "Cocina Elvis, dígame.", "language": "es" },
    { "speaker": "caller", "start": 4, "end": 8, "text": "Quiero unas quesadillas de chicharrón prestado.", "language": "es" },
    { "speaker": "staff", "start": 9, "end": 14, "text": "¿Tortilla hecha a mano, de comal, de harina o doradas?", "language": "es" },
    { "speaker": "caller", "start": 15, "end": 16, "text": "De duro.", "language": "es" },
    { "speaker": "caller", "start": 17, "end": 18, "text": "Hecha mano.", "language": "es" },
    { "speaker": "staff", "start": 19, "end": 24, "text": "Dos quesadillas de comal de prensado, ¿sí?", "language": "es" },
    { "speaker": "caller", "start": 25, "end": 26, "text": "De duro.", "language": "es" },
    { "speaker": "staff", "start": 27, "end": 29, "text": "¿Qué más, mano?", "language": "es" },
    { "speaker": "caller", "start": 30, "end": 34, "text": "Una pregunta, ¿tiene tacos dorados de cueritos?", "language": "es" },
    { "speaker": "staff", "start": 35, "end": 36, "text": "No, joven.", "language": "es" },
    { "speaker": "staff", "start": 37, "end": 44, "text": "Hacemos tacos dorados, pero con las carnes que vendemos, no de cuerito.", "language": "es" },
    { "speaker": "caller", "start": 45, "end": 46, "text": "No.", "language": "es" },
    { "speaker": "caller", "start": 47, "end": 48, "text": "Oh. Oh.", "language": "es" },
    { "speaker": "caller", "start": 49, "end": 53, "text": "Quería eso y una coca de botella.", "language": "es" },
    { "speaker": "staff", "start": 54, "end": 56, "text": "Una coca de botella. ¿A dónde, joven?", "language": "es" },
    { "speaker": "caller", "start": 57, "end": 58, "text": "Quería todo a domicilio.", "language": "es" },
    { "speaker": "caller", "start": 59, "end": 60, "text": "501", "language": "es" },
    { "speaker": "caller", "start": 61, "end": 63, "text": "W Oanta", "language": "es" },
    { "speaker": "staff", "start": 64, "end": 68, "text": "Es la West Walnut, quinientos uno.", "language": "es" },
    { "speaker": "caller", "start": 69, "end": 70, "text": "Sí.", "language": "es" },
    { "speaker": "staff", "start": 71, "end": 78, "text": "Tengo dos quesadillas nomás de comal de duro, tu coca y el delivery, ¿estamos bien?", "language": "es" },
    { "speaker": "caller", "start": 79, "end": 80, "text": "Sí.", "language": "es" },
    { "speaker": "staff", "start": 81, "end": 83, "text": "Son dieciocho dólares.", "language": "es" },
    { "speaker": "staff", "start": 84, "end": 86, "text": "¿Cómo te llamas?", "language": "es" },
    { "speaker": "caller", "start": 87, "end": 89, "text": "Jonathan, Jonathan.", "language": "es" },
    { "speaker": "caller", "start": 90, "end": 94, "text": "Mm, ¿me puedes poner mejor las tres?", "language": "es" },
    { "speaker": "staff", "start": 95, "end": 97, "text": "¿Y una vez tres, seguro?", "language": "es" },
    { "speaker": "caller", "start": 98, "end": 100, "text": "Sí, sí, seguro.", "language": "es" },
    { "speaker": "staff", "start": 101, "end": 106, "text": "Vamos a poner tres quesadillas de duro a Jonathan.", "language": "es" },
    { "speaker": "staff", "start": 107, "end": 111, "text": "Con el delivery son como veintidós, veintitrés.", "language": "es" },
    { "speaker": "caller", "start": 112, "end": 113, "text": "Sí, está bien.", "language": "es" }
  ]
}
