  },
  {
    "speaker": "caller",
    "start": 14.9,
    "end": 15.9,
    "text": "no, de comal.",
    "language": "es"
  },
  {
    "speaker": "staff",
    "start": 15.5,
    "end": 16.5,
    "text": "What, okay, ¿qué más?",
