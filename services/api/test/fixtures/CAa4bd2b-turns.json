  },
  {
    "speaker": "caller",
    "start": 17.4,
    "end": 18.4,
    "text": "Y",
    "language": "es"
  },
  {
    "speaker": "caller",
    "start": 19.8,
    "end": 20.8,
    "text": "me da cuatro de chorizo, también de comal.",
    "language": "es"
  },
  {
    "speaker": "staff",
    "start": 23.1,
    "end": 24.1,
    "text": "Okay, man, ¿qué más?",
