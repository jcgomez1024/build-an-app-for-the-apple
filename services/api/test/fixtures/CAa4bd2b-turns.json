  },
  {
    "speaker": "caller",
    "start": 25.6,
    "end": 26.6,
    "text": "Nada más.",
    "language": "es"
  },
  {
    "speaker": "staff",
    "start": 27.5,
    "end": 28.5,
    "text": "¿A qué no me ponemos la orden que la va a recoger?",
    "language": "es"
  },
  {
    "speaker": "caller",
    "start": 30.1,
    "end": 31.1,
    "text": "Miguel.",
