    "text": "Guille.",
    "language": "es"
  },
  {
    "speaker": "caller",
    "start": 32.7,
    "end": 33.7,
    "text": "Miguel.",
    "language": "es"
  },
  {
    "speaker": "staff",
    "start": 33.2,
    "end": 34.2,
    "text": "Okay, dame, perdón.",
