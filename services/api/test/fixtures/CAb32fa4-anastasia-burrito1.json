      "speaker": "caller",
      "start": 7.141,
      "end": 10.422,
      "text": "actually I have a question first. So you guys do like the chorizo nachos.",
      "language": "en"
    },
    {
      "speaker": "staff",
      "start": 9.163,
      "end": 9.383,
      "text": "Sure.",
      "language": "en"
