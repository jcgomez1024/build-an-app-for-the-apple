    "text": "un burrito",
    "language": "es"
  },
  {
    "speaker": "staff",
    "start": 19.506,
    "end": 19.886,
    "text": "grande",
    "language": "es"
  },
  {
    "speaker": "caller",
    "start": 20.706,
    "end": 21.566,
    "text": "Sí, grande, por favor.",
    "language": "es"
  },
  {
    "speaker": "staff",
    "start": 22.207,
    "end": 23.788,
    "text": "de lengua con guacamole.",
    "language": "es"
  },
  {
    "speaker": "caller",
    "start": 26.307,
    "end": 28.808,
    "text": "Me le pones dos, de una salsita grande de la roja, por favor.",
