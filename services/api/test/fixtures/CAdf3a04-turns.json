  },
  {
    "speaker": "staff",
    "start": 11.424,
    "end": 11.864,
    "text": "A ver, dime.",
    "language": "es"
  },
  {
    "speaker": "caller",
    "start": 13.364,
    "end": 16.705,
    "text": "Tiene una, este burrito con aguacamole de lengua, por favor. Ajá.",
