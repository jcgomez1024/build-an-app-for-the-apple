  },
  {
    "speaker": "staff",
    "start": 30.89,
    "end": 32.371,
    "text": "¿Te gustaría con lechuga también?",
    "language": "es"
  },
  {
    "speaker": "caller",
    "start": 31.109,
    "end": 31.129,
    "text": "Y,",
