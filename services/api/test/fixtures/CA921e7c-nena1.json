  },
  {
   "speaker": "staff",
   "start": 42.01,
   "end": 42.71,
   "text": "A ver, dime ahora sí.",
   "language": "es"
  },
  {
   "speaker": "caller",
   "start": 43.829,
   "end": 44.97,
   "text": "Tres menudos con papa.",
