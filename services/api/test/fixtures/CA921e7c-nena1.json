   "end": 57.073,
   "text": "Tortas, sí. Ah, es de Milanesa. De Milanesa.",
   "language": "es"
  },
  {
   "speaker": "caller",
   "start": 52.371,
   "end": 54.171,
   "text": "Me pone cuatro tortos de milanesa.",
   "language": "es"
  },
