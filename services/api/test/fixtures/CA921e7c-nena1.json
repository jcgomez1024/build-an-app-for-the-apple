   "end": 20.445,
   "text": "para grabarlos de una vez, ¿no?",
   "language": "es"
  },
  {
   "speaker": "staff",
   "start": 21.845,
   "end": 22.606,
   "text": "Oh, ¿qué pasó?",
   "language": "es"
  },
  {
   "speaker": "staff",
   "start": 28.167,
   "end": 28.767,
   "text": "Aquí están, mira.",
   "language": "es"
  },
  {
   "speaker": "staff",
   "start": 29.807,
   "end": 31.408,
   "text": "Me hubieras dicho que era también en esa cali. Sí, era.",
