  },
  {
   "speaker": "staff",
   "start": 64.794,
   "end": 65.214,
   "text": "¿Qué más?",
   "language": "es"
  },
  {
   "speaker": "caller",
   "start": 66.034,
   "end": 68.654,
   "text": "Hay una casa de charrón panizado y otra de duro.",
   "language": "es"
  },
  {
   "speaker": "staff",
   "start": 69.395,
   "end": 70.055,
   "text": "Y de las de Comal.",
