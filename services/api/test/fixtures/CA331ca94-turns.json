[{"speaker": "staff", "start": 1.5, "end": 3.321, "text": "Cocina Elvis, buenas tardes.", "language": "es"}, {"speaker": "caller", "start": 3.882, "end": 5.662, "text": "Ah, bueno, pues sí tiene tacos al vapor.", "language": "es"}, {"speaker": "staff", "start": 6.861, "end": 7.361, "text": "Sí, claro.", "language": "es"}, {"speaker": "caller", "start": 9.304, "end": 10.984, "text": "Ah, ¿sí me puedes dar dos órdenes, por favor?", "language": "es"}, {"speaker": "staff", "start": 12.262, "end": 12.583, "text": "Perdón.", "language": "es"}, {"speaker": "caller", "start": 13.225, "end": 28.732, "text": "¿Sí me puedes dar dos órdenes de tacos al vapor? Eh, me pone uno, en una orden me pone uno de, de papas, uno de frijol y tres de prensado.", "language": "es"}, {"speaker": "staff", "start": 15.943, "end": 22.325, "text": "Claro, ¿de qué te los vamos a poner? Vienen cinco, hay de papa, frijoles, prensado, pollo y queso.", "language": "es"}, {"speaker": "staff", "start": 30.286, "end": 33.747, "text": "A ver, uno de papa, uno de frijol y", "language": "es"}, {"speaker": "caller", "start": 34.594, "end": 34.614, "text": "Y,", "language": "es"}, {"speaker": "staff", "start": 34.667, "end": 35.467, "text": "tres de prensado.", "language": "es"}, {"speaker": "caller", "start": 35.934, "end": 43.157, "text": "ajá. Me pone cuatro de prensado y lleno de frijoles.", "language": "es"}, {"speaker": "staff", "start": 37.228, "end": 37.688, "text": "Muy bien.", "language": "es"}, {"speaker": "staff", "start": 38.788, "end": 40.008, "text": "¿Y en la segunda orden?", "language": "es"}, {"speaker": "staff", "start": 41.128, "end": 41.368, "text": "Bueno,", "language": "es"}, {"speaker": "staff", "start": 42.309, "end": 42.669, "text": "dech,", "language": "es"}, {"speaker": "staff", "start": 44.309, "end": 44.649, "text": "de hecho,", "language": "es"}, {"speaker": "staff", "start": 46.569, "end": 46.85, "text": "tres,", "language": "es"}, {"speaker": "staff", "start": 48.35, "end": 49.31, "text": "tres, cua,", "language": "es"}, {"speaker": "staff", "start": 50.77, "end": 53.731, "text": "cuatro, cinco, ok. ¿Y en la otra orden?", "language": "es"}, {"speaker": "caller", "start": 54.562, "end": 56.363, "text": "Otro de prensado y lleno de frijoles.", "language": "es"}, {"speaker": "staff", "start": 60.913, "end": 62.513, "text": "Aunque no te escuché bien, ¿perdón?", "language": "es"}, {"speaker": "caller", "start": 63.345, "end": 64.966, "text": "Me da como de prensado y lleno de,", "language": "es"}, {"speaker": "caller", "start": 65.946, "end": 66.966, "text": "y lleno de frijoles.", "language": "es"}, {"speaker": "staff", "start": 68.855, "end": 69.196, "text": "Uno de,", "language": "es"}, {"speaker": "staff", "start": 73.377, "end": 74.737, "text": "y uno de frijoles.", "language": "es"}, {"speaker": "staff", "start": 76.098, "end": 78.059, "text": "Y los otros, ¿de qué te los pongo?", "language": "es"}, {"speaker": "caller", "start": 78.51, "end": 79.491, "text": "De prensado cuatro.", "language": "es"}, {"speaker": "staff", "start": 81.56, "end": 83.981, "text": "Entonces, cuatro de prensado y uno de frijoles.", "language": "es"}, {"speaker": "caller", "start": 84.352, "end": 84.552, "text": "Ajá.", "language": "es"}, {"speaker": "staff", "start": 85.461, "end": 86.842, "text": "Muy bien, entonces tengo", "language": "es"}, {"speaker": "staff", "start": 87.822, "end": 88.322, "text": "uno de,", "language": "es"}, {"speaker": "staff", "start": 92.164, "end": 100.787, "text": "dos de, dos de frijoles y tres de prensado, y en la segunda, oh. Ujú.", "language": "es"}, {"speaker": "caller", "start": 96.256, "end": 99.718, "text": "No, no, no, no, no, una es de uno de frijoles, nomás son dos órdenes.", "language": "es"}, {"speaker": "caller", "start": 101.758, "end": 103.819, "text": "Eso no, uno de frijoles y cuatro de prensado.", "language": "es"}, {"speaker": "caller", "start": 106.36, "end": 109.681, "text": "Y la otra orden es uno de frijoles, uno de papa y tres de prensado.", "language": "es"}, {"speaker": "staff", "start": 110.45, "end": 115.512, "text": "Uno de papa, uno de frijoles y tres de prensado, y luego cuatro de prensado y uno de frijoles.", "language": "es"}, {"speaker": "caller", "start": 113.342, "end": 116.923, "text": "Ajá. Exactamente, ajá.", "language": "es"}, {"speaker": "staff", "start": 116.992, "end": 119.493, "text": "Muy bien, ¿a qué nombre sería la orden?", "language": "es"}, {"speaker": "caller", "start": 119.845, "end": 122.466, "text": "Y también me pones una quesitoto de chorizo, por favor.", "language": "es"}, {"speaker": "staff", "start": 123.134, "end": 123.614, "text": "Claro,", "language": "es"}, {"speaker": "staff", "start": 124.914, "end": 125.555, "text": "¿algo más?", "language": "es"}, {"speaker": "caller", "start": 125.989, "end": 126.489, "text": "Sería todo.", "language": "es"}, {"speaker": "staff", "start": 130.116, "end": 133.577, "text": "Muy bien, dame tu nombre por favor para la orden.", "language": "es"}, {"speaker": "caller", "start": 133.753, "end": 134.674, "text": "Víctor, Víctor.", "language": "es"}, {"speaker": "staff", "start": 135.557, "end": 138.718, "text": "Víctor, muy bien, Víctor, dame unos quince minutos.", "language": "es"}, {"speaker": "caller", "start": 139.417, "end": 140.718, "text": "Okay, perfecto. Ajá.", "language": "es"}, {"speaker": "staff", "start": 141.619, "end": 142.139, "text": "Gracias.", "language": "es"}, {"speaker": "caller", "start": 142.479, "end": 143.339, "text": "Dime de qué hasta luego.", "language": "es"}]