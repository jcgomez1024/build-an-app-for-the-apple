[{"speaker": "staff", "start": 0.26, "end": 1.401, "text": "Cocina de bis.", "language": "es"}, {"speaker": "caller", "start": 2.581, "end": 4.022, "text": "¿Qué me puedes tomar una orden, por favor?", "language": "es"}, {"speaker": "staff", "start": 4.562, "end": 5.362, "text": "Claro, dígame.", "language": "es"}, {"speaker": "caller", "start": 6.583, "end": 9.184, "text": "Serían cuatro quesadillas en aceite de bistec.", "language": "es"}, {"speaker": "staff", "start": 9.704, "end": 11.525, "text": "Muy bien, ¿preparadas o regulares?", "language": "es"}, {"speaker": "caller", "start": 12.705, "end": 14.666, "text": "No regulares, con la verdura aparte, por favor.", "language": "es"}, {"speaker": "staff", "start": 15.607, "end": 17.167, "text": "Okay, muy bien, ¿algo más?", "language": "es"}, {"speaker": "caller", "start": 17.427, "end": 20.689, "text": "Y también, sí, también me vendes un pico de gallo con chips.", "language": "es"}, {"speaker": "staff", "start": 21.209, "end": 21.589, "text": "Claro.", "language": "es"}, {"speaker": "caller", "start": 23.07, "end": 23.57, "text": "Eso sería todo.", "language": "es"}, {"speaker": "staff", "start": 23.23, "end": 28.392, "text": "¿Algo más? Okay, entonces te tengo, entonces te tengo cuatro doradas", "language": "es"}, {"speaker": "caller", "start": 24.851, "end": 25.511, "text": "No, eso sería todo.", "language": "es"}, {"speaker": "staff", "start": 29.432, "end": 32.774, "text": "regulares de bistec y un pico de gallo.", "language": "es"}, {"speaker": "caller", "start": 34.174, "end": 34.555, "text": "Correcto.", "language": "es"}, {"speaker": "staff", "start": 35.255, "end": 36.956, "text": "Okay, ¿a qué nombre sería la orden?", "language": "es"}, {"speaker": "caller", "start": 37.996, "end": 38.196, "text": "Noé.", "language": "es"}, {"speaker": "staff", "start": 39.197, "end": 43.158, "text": "Noe. Muy bien, Noe, dame unos veinte minutos, ¿está bien?", "language": "es"}, {"speaker": "caller", "start": 44.179, "end": 44.439, "text": "Sale.", "language": "es"}, {"speaker": "staff", "start": 45.039, "end": 45.839, "text": "Okay, gracias.", "language": "es"}, {"speaker": "caller", "start": 45.639, "end": 46.039, "text": "Gracias.", "language": "es"}]