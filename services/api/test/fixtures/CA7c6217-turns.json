  },
  {
    "speaker": "caller",
    "start": 95.365,
    "end": 95.965,
    "text": "Sería todo.",
    "language": "es"
  },
  {
    "speaker": "staff",
    "start": 96.825,
    "end": 98.265,
    "text": "Okay, serían,",
    "language": "es"
  },
  {
    "speaker": "staff",
    "start": 99.966,
    "end": 102.528,
    "text": "mmm, entonces no quiere verdura, déjele pongo una,",
    "language": "es"
  },
  {
    "speaker": "staff",
    "start": 103.788,
    "end": 104.629,
    "text": "no verdura.",
    "language": "en"
  },
  {
    "speaker": "staff",
    "start": 108.671,
    "end": 108.931,
    "text": "Okay,",
    "language": "es"
  },
  {
    "speaker": "staff",
    "start": 110.192,
    "end": 114.174,
    "text": "ah, deme unos veinte minutos, ¿a qué nombre sería la orden?",
    "language": "es"
  },
  {
    "speaker": "caller",
    "start": 114.914,
    "end": 115.315,
    "text": "A Daniel.",
    "language": "es"
  },
  {
    "speaker": "staff",
    "start": 116.195,
    "end": 118.296,
    "text": "Daniel, okay, deme unos,",
    "language": "es"
  },
  {
    "speaker": "caller",
    "start": 116.255,
    "end": 124.179,
    "text": "Ajá. No, está bien, gracias.",
