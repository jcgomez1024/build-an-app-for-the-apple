[{"speaker": "staff", "start": 0.32, "end": 0.641, "text": "Sí, bueno.", "language": "es"}, {"speaker": "caller", "start": 2.662, "end": 4.764, "text": "Buenas noches, ¿me puede hacer un orden, por favor?", "language": "es"}, {"speaker": "staff", "start": 5.224, "end": 5.885, "text": "Claro, dime.", "language": "es"}, {"speaker": "caller", "start": 7.847, "end": 10.449, "text": "Ah, ¿va a ser una orden de chiles rellenos?", "language": "es"}, {"speaker": "staff", "start": 11.029, "end": 13.231, "text": "Chile relleno se me acabaron, no hay disculpa.", "language": "en"}, {"speaker": "caller", "start": 14.973, "end": 17.495, "text": "O deja hablo, a ver, pues, ¿qué qué más quieren?", "language": "es"}, {"speaker": "staff", "start": 17.975, "end": 18.876, "text": "Ah, okay, muy bien.", "language": "es"}, {"speaker": "caller", "start": 19.416, "end": 21.158, "text": "Ahorita hablo para atrás, gracias.", "language": "es"}, {"speaker": "staff", "start": 20.778, "end": 21.979, "text": "Ya está, sale a ti.", "language": "es"}]