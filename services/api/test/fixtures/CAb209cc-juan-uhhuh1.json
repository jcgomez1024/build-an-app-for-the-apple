  },
  {
   "speaker": "staff",
   "start": 31.706,
   "end": 32.966,
   "text": "con arroz",
   "language": "es"
  },
  {
   "speaker": "staff",
   "start": 34.466,
   "end": 34.486,
   "text": "y,",
   "language": "es"
  },
  {
   "speaker": "staff",
   "start": 36.067,
   "end": 42.328,
   "text": "perdón, espérame, viene con arroz y tres tortillas de comal o de harina, las que usted guste.",
   "language": "es"
  },
  {
   "speaker": "staff",
   "start": 43.268,
   "end": 45.529,
   "text": "Vale a diecisiete el platillo.",
   "language": "es"
  },
  {
   "speaker": "caller",
   "start": 46.166,
   "end": 47.306,
   "text": "A diecisiete el platillo.",
   "language": "es"
  },
  {
   "speaker": "staff",
   "start": 47.91,
   "end": 48.03,
   "text": "Sí.",
   "language": "es"
  },
  {
   "speaker": "caller",
   "start": 49.267,
   "end": 51.227,
   "text": "Okey, ¿me puedes poner una orden, por favor?",
