   "start": 10.842,
   "end": 12.162,
   "text": "Ah, sí, claro.",
   "language": "es"
  },
  {
   "speaker": "caller",
   "start": 12.942,
   "end": 13.562,
   "text": "¿Si tiene mole?",
   "language": "es"
  },
  {
   "speaker": "staff",
   "start": 14.343,
   "end": 14.443,
   "text": "Sí.",
   "language": "es"
  },
  {
   "speaker": "caller",
   "start": 15.502,
   "end": 16.462,
   "text": "¿A cuánto da la orden?",
   "language": "es"
  },
  {
   "speaker": "staff",
   "start": 17.563,
   "end": 21.404,
   "text": "Eh, la orden de mole, nomás,",
   "language": "es"
  },
  {
   "speaker": "staff",
   "start": 22.384,
   "end": 23.504,
   "text": "a ver, permíteme,",
   "language": "es"
  },
  {
   "speaker": "staff",
   "start": 28.945,
   "end": 30.506,
   "text": "mm, a ver, mire, viene",
