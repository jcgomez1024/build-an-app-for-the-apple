  },
  {
   "speaker": "caller",
   "start": 56.588,
   "end": 57.148,
   "text": "Para Juan.",
   "language": "es"
  },
  {
   "speaker": "staff",
   "start": 58.073,
   "end": 60.994,
   "text": "Juan, ok, muy bien, ¿algo más?",
   "language": "es"
  },
  {
   "speaker": "caller",
   "start": 61.93,
   "end": 65.353,
   "text": "Uh-huh. Ah, solamente eso, por favor.",
