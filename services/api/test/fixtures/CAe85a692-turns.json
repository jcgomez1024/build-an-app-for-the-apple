[{"speaker": "staff", "start": 1.1, "end": 1.42, "text": "S\u00ed, bueno.", "language": "es"}, {"speaker": "caller", "start": 3.241, "end": 7.182, "text": "Hola, \u00bfsabes, oiga? No, no, no tiene delivery.", "language": "en"}, {"speaker": "staff", "start": 4.421, "end": 5.082, "text": "Buenas tardes.", "language": "es"}, {"speaker": "staff", "start": 8.003, "end": 9.703, "text": "Claro, \u00bfpara d\u00f3nde vas a ir, amigazo?", "language": "es"}, {"speaker": "caller", "start": 10.584, "end": 12.924, "text": "Eh, aqu\u00ed va a ser en Pensil, aqu\u00ed en la,", "language": "es"}, {"speaker": "staff", "start": 12.884, "end": 17.646, "text": "Ah. A la Curlan, \u00bfme das el n\u00famero de tu casa?", "language": "es"}, {"speaker": "caller", "start": 13.845, "end": 14.385, "text": "en la Portland.", "language": "es"}, {"speaker": "caller", "start": 18.846, "end": 20.607, "text": "Eh, es 2:46.", "language": "es"}, {"speaker": "staff", "start": 21.307, "end": 21.867, "text": "A ver, esp\u00e9rame.", "language": "es"}, {"speaker": "caller", "start": 22.968, "end": 25.429, "text": "Me llama mucho el heno, ya, ya he pedido ah\u00ed, a veces llego.", "language": "es"}, {"speaker": "staff", "start": 23.307, "end": 23.647, "text": "Dos.", "language": "es"}, {"speaker": "staff", "start": 26.528, "end": 28.069, "text": "Dos cuarenta y seis Curlan.", "language": "es"}, {"speaker": "caller", "start": 28.97, "end": 30.49, "text": "Aj\u00e1, este, este, eh,", "language": "es"}, {"speaker": "staff", "start": 29.509, "end": 29.989, "text": "Okay, \u00bfqu\u00e9 te", "language": "es"}, {"speaker": "staff", "start": 31.01, "end": 32.01, "text": "qu\u00e9 te vamos a poner?", "language": "es"}, {"speaker": "caller", "start": 33.752, "end": 34.932, "text": "quer\u00eda unas,", "language": "es"}, {"speaker": "caller", "start": 35.932, "end": 37.953, "text": "mmm, unas dos tortas de bistec.", "language": "es"}, {"speaker": "staff", "start": 38.772, "end": 40.073, "text": "\u00bfCon queso o