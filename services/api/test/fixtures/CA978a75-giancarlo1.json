  },
  {
   "speaker": "caller",
   "start": 13.206,
   "end": 15.487,
   "text": "¿Así me puede poner un un vaso de menudo?",
   "language": "es"
  },
  {
   "speaker": "staff",
   "start": 15.987,
   "end": 16.327,
   "text": "¿Qué más?",
