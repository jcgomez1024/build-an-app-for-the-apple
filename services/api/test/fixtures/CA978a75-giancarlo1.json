   "start": 25.551,
   "end": 25.651,
   "text": "Sí.",
   "language": "es"
  },
  {
   "speaker": "staff",
   "start": 26.712,
   "end": 27.192,
   "text": "¿Qué más, mano?",
   "language": "es"
  },
  {
   "speaker": "caller",
   "start": 27.792,
   "end": 30.053,
   "text": "Y una agua de horchata grande y sería todo.",
   "language": "es"
  },
  {
   "speaker": "staff",
   "start": 31.374,
   "end": 32.634,
   "text": "Un agua de horchata grande.",
